# Copy to .env and supply your own credentials. Do not commit .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
PAPER_MODE=true
DHAN_BOT_MODE=PAPER

# Conservative Nifty continuation; broader rejected experiments stay off.
NIFTY_OPENING_TREND=true
NIFTY_PRICE_LEVEL_CONFIRMATION=false

# Approved stock-option limits and continuation profile.
STOCK_OPT_INITIAL_CAPITAL=50000
STOCK_OPT_MAX_DAILY_TRADES=2
STOCK_OPT_MAX_CONCURRENT=2
STOCK_OPT_RUPEE_TARGET=900
STOCK_OPT_RUPEE_MAX_RISK=1000
STOCK_OPT_MAX_LOTS=3
STOCK_OPT_TARGET_PCT=10
STOCK_OPT_STOP_PCT=5
STOCK_OPT_MIN_NET_RR=1.3
STOCK_OPT_OPENING_TREND=true
STOCK_OPT_EXTEND_RUPEE_TARGET=true
STOCK_OPT_REENTRY_AFTER_LOSS=true
STOCK_OPT_MIN_DAYS_TO_EXPIRY=4
STOCK_OPT_MAX_SPREAD_PCT=3.5
STOCK_OPT_CONFIRM_WINDOW_SEC=600
